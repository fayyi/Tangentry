# Optional overrides. The server reads environment variables; it does not auto-load this file.
# Copy to .env, edit locally, then run: set -a; source .env; set +a

# Used by docker-compose.yml to select your published Docker Hub image.
DOCKERHUB_USERNAME=your-dockerhub-username

# tangentry-server only (Docker sets the first two).
# TANGENTRY_ADDR=:7380
# TANGENTRY_DATA=/data
# Generated into <data>/admin-password on first run when unset.
# TANGENTRY_PASSWORD=

TANGENTRY_YTDLP_PATH=
TANGENTRY_FFMPEG_PATH=
TANGENTRY_DOWNLOAD_DIR=
TANGENTRY_DOWNLOAD_TIMEOUT=2h
# Optional path to your own private Netscape-format Bilibili cookies file.
# Credentials stay outside source control. Browser cookies are never read automatically.
TANGENTRY_BILIBILI_COOKIE_FILE=

# Optional directory for verified yt-dlp / Deno downloads on first use, as the
# desktop app does. Leave unset to use yt-dlp from PATH or TANGENTRY_YTDLP_PATH.
# TANGENTRY_TOOLS_DIR=/path/to/data/tools
# Optional local speech tools; saved Tools settings override these defaults.
# TANGENTRY_WHISPER_PATH=/path/to/whisper-cli
# TANGENTRY_WHISPER_MODEL=/path/to/models/ggml-base.bin
# TANGENTRY_FASTER_WHISPER_PYTHON=/path/to/faster-whisper-venv/bin/python
# TANGENTRY_WHISPER_MODELS_DIR=/path/to/models
